{
  "compilerOptions": {
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "resolvePackageJsonExports": true,
    "esModuleInterop": true,
    "isolatedModules": true,
    "declaration": true,
    "removeComments": true,
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "allowSyntheticDefaultImports": true,
    "target": "ES2023",
    "sourceMap": true,
    "outDir": "./dist",
    "baseUrl": "./",
    // Only these @types packages are auto-included as globals. Everything else is resolved through
    // normal imports. This is load-bearing: metaapi.cloud-sdk depends on the long-deprecated
    // @types/socket.io-client@1, which npm hoists into node_modules/@types. That package contains an
    // ambient `declare module 'socket.io-client'`, and an ambient declaration OVERRIDES the real
    // socket.io-client@4 typings — breaking tradelocker/connection.ts with "has no exported member
    // 'io'". Auto-inclusion is the only way it can reach us, so scoping `types` shuts it out.
    "types": ["node", "jest"],
    "incremental": true,
    "tsBuildInfoFile": "./dist/.tsbuildinfo",
    "skipLibCheck": true,
    "strictNullChecks": true,
    "forceConsistentCasingInFileNames": true,
    "noImplicitAny": false,
    "strictBindCallApply": false,
    "noFallthroughCasesInSwitch": false
  }
}

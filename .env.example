# === Database (Neon Postgres — same instance as the main app) ===
# Pooled connection string (hostname contains `-pooler`). Runtime uses this via @prisma/adapter-pg.
# Keep `?sslmode=require` — Neon requires TLS.
DATABASE_URL=postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/DB?sslmode=require

# === Server ===
# Local dev port (frontend runs on 3000). Fly injects PORT=8080.
PORT=3001
NODE_ENV=development

# === cTrader (Phase 1+) ===
# ENCRYPTION_KEY must EQUAL the main app's key, otherwise stored tokens can't be decrypted.
ENCRYPTION_KEY=
CTRADER_CLIENT_ID=
CTRADER_CLIENT_SECRET=
CTRADER_REDIRECT_URI=

# --- PoC-only account override (optional) ---
# If set, the PoC connects this single account instead of reading the DB. Handy before any
# cTrader account is connected in the main app.
# CTRADER_POC_ACCESS_TOKEN=
# CTRADER_POC_ACCOUNT_ID=
# CTRADER_POC_ENVIRONMENT=demo

# === TradeLocker (Streams API live-sync) ===
# Master switch — the socket live-sync stays OFF unless this is exactly 'true'. Keep it off until our
# production Streams API key is approved by TradeLocker.
TRADELOCKER_LIVE_SYNC_ENABLED=false
# developer-api-key for the Streams socket handshake (NOT sent on the auth request).
TRADELOCKER_DEVELOPER_API_KEY=
# Telegram notify (reuses the main app's bot + feedback chat — set the SAME values). When both are set,
# the worker posts a one-off "live close captured" message. Unset = notifications skipped.
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_FEEDBACK_CHAT_ID=
# Staged-rollout / test scope: comma-separated user ids whose TradeLocker accounts the worker manages
# exclusively (mirrors CTRADER_ONLY_USER_IDS). Unset/empty = manage ALL tradelocker accounts.
# TRADELOCKER_ONLY_USER_IDS=
# Optional: override the auth host that issues stream JWTs (/backend-api/auth/jwt/accounts/tokens).
# Defaults match the main app's REST importer: demo -> https://demo.tradelocker.com,
# live -> https://live.tradelocker.com. Only set this to target TradeLocker staging (stg.*).
# TRADELOCKER_AUTH_BASE_URL=
# Optional: override the streams SOCKET host. Defaults: demo -> wss://api-dev.tradelocker.com,
# live -> wss://api.tradelocker.com. The developer-api-key is environment-scoped — a demo key only
# works on the demo/dev socket, a live key on production. Wrong pairing =>
# "unauthorized.streams.developer.notFound". Set this to flip hosts without a code change.
# TRADELOCKER_STREAM_BASE_URL=

# --- Account source ---
# Phase 3+ is DB-driven: the worker manages every TradingAccount with terminalType='tradelocker' whose
# terminalIntegrationStatus != 'deactivated' (creds read from TerminalCredentials). The TRADELOCKER_POC_*
# vars below are superseded and no longer read by the manager — left documented for reference only.
# TRADELOCKER_POC_EMAIL=
# TRADELOCKER_POC_PASSWORD=
# TRADELOCKER_POC_SERVER=
# TRADELOCKER_POC_ENVIRONMENT=demo
# TRADELOCKER_POC_ACCOUNT_ID=

# === Sentry ===
# DSN is not secret (it has a sane fallback in src/instrument.ts); override it here only to point
# at a different project. AUTH_TOKEN/ORG/PROJECT are build-time only — used by `npm run
# sentry:sourcemaps` to upload source maps; the token IS secret, so keep it out of git.
# SENTRY_DSN=
SENTRY_AUTH_TOKEN=
SENTRY_ORG=tradetrack
SENTRY_PROJECT=tradetrack-api
TRADELOCKER_STREAM_BASE_URL=wss://api.tradelocker.com

# === MetaApi (MT5 realtime sync) ===
# Server-side only — NEVER exposed to the browser. Generate at
# https://app.metaapi.cloud/api-access/generate-token with exactly these scopes:
#   trading-account-management-api  (create / deploy / undeploy / delete)
#   metaapi-rpc-api                 (getDealsByTimeRange, getPositions)
#   metaapi-real-time-streaming-api (SynchronizationListener)
# Do NOT grant MT manager API or Billing API. The token EXPIRES — a 401 means the token died, not the
# trading account, and must never deactivate/delete an account. Pick the longest validity offered.
METAAPI_TOKEN=
# Master switch — the connection manager stays idle unless this is exactly 'true'. Keep it off until
# the integration is verified end-to-end (Phase 3). createAccount DEPLOYS the account and bills a
# 6-hour minimum, so flipping this on starts spending money.
METAAPI_LIVE_SYNC_ENABLED=false
# Optional MetaApi region hint passed to createAccount (e.g. london, new-york).
METAAPI_REGION=
# Staged-rollout / test scope: comma-separated user ids whose MetaApi accounts the worker manages
# exclusively (mirrors CTRADER_ONLY_USER_IDS). Read via process.env in the connection manager — it
# MUST be declared in env.validation.ts, otherwise Zod strips it. Empty/unset = all metaapi accounts.
METAAPI_ONLY_USER_IDS=

# --- Phase 0 spike only (local; NEVER put these in Fly secrets) ---
# MT5 login digits, the broker's server name, and the INVESTOR (read-only) password. 2FA must be off.
# Used solely by `npm run spike:metaapi`, which deploys a cloud terminal and bills 6 hours minimum.
# METAAPI_POC_LOGIN=
# METAAPI_POC_SERVER=
# METAAPI_POC_PASSWORD=

  @@index([userId])
  @@index([notifyAt])
}

model TradingJournal {
  id     String   @id @default(cuid())
  userId String
  user   User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  date   DateTime @db.Date

  // pre-market planning
  preMarketPlan    String? @db.Text
  dailyGoal        String?
  marketConditions String?

  // post-market review
  postMarketReview String? @db.Text
  goalAchieved     String?
  lessonLearned    String? @db.Text


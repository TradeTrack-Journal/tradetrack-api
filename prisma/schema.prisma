  @@index([userId])
  @@index([date])
}

// ═══════════════════════════════════════════════════════════════════════════
// STRATEGIES - Trading Setups (TradZilla-style with Groups & Rules)
// ═══════════════════════════════════════════════════════════════════════════

model TradingSetup {
  id          String   @id @default(cuid())
  name        String
  emoji       String?
  color       String?  // hex color e.g. "#4f46e5"
  description String?  @db.Text
  symbols       String[]
  isPublic      Boolean  @default(false)
  shareId       String?  @unique
  shareAllowCopy Boolean @default(true)

  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  ruleSetId String?  @unique
  ruleSet   RuleSet? @relation(fields: [ruleSetId], references: [id], onDelete: SetNull)

  trades      Trade[]
  backtests   Backtest[]
  notes       SetupNote[]
  screenshots SetupScreenshot[]
  shares      SetupShare[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([isPublic])
  @@index([ruleSetId])
}

enum SetupScreenshotCategory {
  A_PLUS
  MISTAKE
  VARIATION
}

model SetupScreenshot {
  id        String                  @id @default(cuid())
  setupId   String
  setup     TradingSetup            @relation(fields: [setupId], references: [id], onDelete: Cascade)
  userId    String
  user      User                    @relation(fields: [userId], references: [id], onDelete: Cascade)
  url       String
  pathname  String
  caption     String?
  category    SetupScreenshotCategory @default(A_PLUS)
  description String?                 @map("timeframe")
  sortOrder   Int                     @default(0)
  createdAt DateTime                @default(now())

  @@index([setupId])
  @@index([userId])
}

model SetupShare {
  id           String       @id @default(cuid())
  setupId      String
  setup        TradingSetup @relation(fields: [setupId], references: [id], onDelete: Cascade)
  ownerId      String
  owner        User         @relation("SetupShareOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  invitedEmail String
  createdAt    DateTime     @default(now())

  @@unique([setupId, invitedEmail])
  @@index([invitedEmail])
  @@index([setupId])
  @@index([ownerId])
}

// ═══════════════════════════════════════════════════════════════════════════
// Setup Notes - free-form notes attached to a trading setup
// ═══════════════════════════════════════════════════════════════════════════

model SetupNote {
  id        String       @id @default(cuid())
  setupId   String
  setup     TradingSetup @relation(fields: [setupId], references: [id], onDelete: Cascade)
  userId    String
  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String       @default("Untitled")
  content   String?      @db.Text
  sortOrder Int          @default(0)
  sharedVisible Boolean  @default(false)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  @@index([setupId])
  @@index([userId])
}

// ═══════════════════════════════════════════════════════════════════════════
// Mistake Templates - reusable trading mistake presets
// ═══════════════════════════════════════════════════════════════════════════

model MistakeTemplate {
  id               String   @id @default(cuid())
  name             String
  shortDescription String?  @db.Text
  category         String?
  userId           String
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@unique([userId, name])
  @@index([userId])
}

// ═══════════════════════════════════════════════════════════════════════════
// Note templates - user-defined TipTap JSON defaults per kind
// ═══════════════════════════════════════════════════════════════════════════

model NoteTemplate {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  kind      String
  name      String
  nameKey   String
  emoji     String?
  color     String?
  content   String   @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  defaultForUsers UserNoteTemplateDefault[]

  @@unique([userId, kind, nameKey])
  @@index([userId, kind])
}

model UserNoteTemplateDefault {
  userId     String
  kind       String
  templateId String?
  updatedAt  DateTime @updatedAt

  user     User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  template NoteTemplate? @relation(fields: [templateId], references: [id], onDelete: SetNull)

  @@id([userId, kind])
  @@index([templateId])
}

// ═══════════════════════════════════════════════════════════════════════════
// User Achievements - gamification system
// ═══════════════════════════════════════════════════════════════════════════

model UserAchievement {
  id            String   @id @default(cuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  achievementId String
  unlockedAt    DateTime @default(now())
  progress      Int      @default(0)
  maxProgress   Int      @default(1)

  @@unique([userId, achievementId])
  @@index([userId])
  @@index([achievementId])
}

// ═══════════════════════════════════════════════════════════════════════════
// EMAIL CAMPAIGNS
// ═══════════════════════════════════════════════════════════════════════════

model UserEmailCampaign {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  campaignType String // 'feedback_request' | 'onboarding_reminder' | 're_engagement' | 'long_term_feedback'
  locale       String // 'uk' | 'en' - мова, на якій було відправлено email
  subject      String
  sentAt       DateTime @default(now())

  // Tracking (опціонально, якщо використовуєте Resend webhooks)
  openedAt  DateTime?
  clickedAt DateTime?
  bouncedAt DateTime?
  complainedAt DateTime?
  deliveredAt DateTime?
  resendEmailId String?
  error     String?   @db.Text

  // Metadata для зручності
  metadata Json? // { googleFormUrl, hasTrades, etc. }

  createdAt DateTime @default(now())

  @@index([userId])
  @@index([campaignType])
  @@index([locale])
  @@index([sentAt])
  @@index([userId, campaignType]) // для швидкого пошуку останньої розсилки
  @@index([userId, campaignType, locale]) // для пошуку останньої розсилки конкретної мови
  @@index([resendEmailId])
}

// ═══════════════════════════════════════════════════════════════════════════
// BLOG - SEO articles (public, no userId - managed by admin)
// ═══════════════════════════════════════════════════════════════════════════

model BlogPost {
  id              String    @id @default(cuid())
  slug            String    @unique
  /** locale of the article, e.g. 'en' | 'uk' */
  locale          String    @default("en")
  /** optional key to group translations of the same article across locales */
  translationKey  String?
  title           String
  metaDescription String?   @db.Text
  content         String    @db.Text
  coverImageUrl   String?   @db.Text
  publishedAt     DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([publishedAt])
  @@index([slug])
  @@index([locale, publishedAt])
  @@index([translationKey])
}

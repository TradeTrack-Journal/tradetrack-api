model ScheduledNotification {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  eventId     String
  eventTitle  String
  eventTime   DateTime
  notifyAt    DateTime
  qstashMsgId String?
  sent        Boolean  @default(false)
  createdAt   DateTime @default(now())


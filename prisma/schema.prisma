}

model EntryTimeframeTool {
  id                       String                    @id @default(cuid())
  name                     String
  description              String?                   @db.Text
  userId                   String
  user                     User                      @relation(fields: [userId], references: [id], onDelete: Cascade)
  isDefault                Boolean                   @default(false)
  trades                   Trade[]
  tradeEntryTimeframeTools TradeEntryTimeframeTool[]
  createdAt                DateTime                  @default(now())
  updatedAt                DateTime                  @updatedAt

  @@index([userId, name])
}

model FtaTool {
  id            String         @id @default(cuid())
  name          String
  description   String?        @db.Text
  userId        String
  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  isDefault     Boolean        @default(false)
  trades        Trade[]
  tradeFtaTools TradeFtaTool[]
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  @@index([userId, name])
}

model TargetTool {
  id               String            @id @default(cuid())
  name             String
  description      String?           @db.Text
  userId           String
  user             User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  isDefault        Boolean           @default(false)
  trades           Trade[]
  tradeTargetTools TradeTargetTool[]
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  @@index([userId, name])
}

model Backtest {
  id             String          @id @default(cuid())
  name           String
  description    String?
  conclusionNotes String?         @db.Text
  status         String          @default("in_progress")
  strategy       String?
  symbol         String?
  timeframe      String?
  tradingSetupId String?
  tradingSetup   TradingSetup?   @relation(fields: [tradingSetupId], references: [id], onDelete: SetNull)
  userId         String
  user           User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  trades         BacktestTrade[]
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  @@index([userId])
  @@index([tradingSetupId])
}

model BacktestTrade {
  id                 String          @id @default(cuid())
  backtestId         String
  backtest           Backtest        @relation(fields: [backtestId], references: [id], onDelete: Cascade)
  userId             String
  user               User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  date               DateTime?
  exitDate           DateTime?
  tradingSessionId   String?
  tradingSession     TradingSession? @relation(fields: [tradingSessionId], references: [id], onDelete: SetNull)
  pair               String?
  direction      String?
  scenario       String?
  riskPercentage Float?
  rr             Float?
  resultPercent  Float?
  rrLabel        String?
  pnl            Float?
  followedPlan   Boolean?  @default(false)
  notes          String?   @db.Text
  analysisNotes  String?   @db.Text
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([userId])
  @@index([backtestId])
  @@index([date])
  @@index([tradingSessionId])
}

model UserTablePreference {
  id           String   @id @default(cuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tableId      String
  columnWidths Json?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([userId, tableId])
  @@index([userId])
}

model Dashboard {
  id          String           @id @default(cuid())
  userId      String
  user        User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  name        String
  description String?
  isDefault   Boolean          @default(false)
  pages       DashboardPage[]
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  @@index([userId])
  @@unique([userId, isDefault], map: "user_default_dashboard_unique")
}

model DashboardPage {
  id          String           @id @default(cuid())
  dashboardId String
  dashboard   Dashboard        @relation(fields: [dashboardId], references: [id], onDelete: Cascade)
  name        String
  slug        String
  order       Int              @default(0)
  widgets     WidgetInstance[]
  layouts     WidgetLayout[]
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  @@index([dashboardId, order])
  @@unique([dashboardId, slug])
}

model WidgetInstance {
  id              String          @id @default(cuid())
  dashboardPageId String
  dashboardPage   DashboardPage   @relation(fields: [dashboardPageId], references: [id], onDelete: Cascade)
  widgetType      String
  title           String?
  config          Json
  layouts         WidgetLayout[]
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  @@index([dashboardPageId])
}

model WidgetLayout {
  id               String         @id @default(cuid())
  dashboardPageId  String
  dashboardPage    DashboardPage  @relation(fields: [dashboardPageId], references: [id], onDelete: Cascade)
  widgetInstanceId String
  widgetInstance   WidgetInstance @relation(fields: [widgetInstanceId], references: [id], onDelete: Cascade)
  breakpoint       String
  x                Int
  y                Int
  w                Int
  h                Int
  minW             Int?
  minH             Int?
  maxW             Int?
  maxH             Int?

  @@index([dashboardPageId, breakpoint])
  @@unique([dashboardPageId, breakpoint, widgetInstanceId])
}

model Analytics {
  id         String        @id @default(cuid())
  userId     String
  user       User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  fromDate   DateTime
  toDate     DateTime
  symbol     String
  bias       String
  biasResult String?
  dayOfWeek  String?
  notes      String?       @db.Text
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt
  analyticNotes AnalyticsNote[]

  @@index([userId])
  @@index([fromDate])
  @@index([toDate])
  @@index([symbol])
}

// ═══════════════════════════════════════════════════════════════════════════
// Analytics Notes - free-form notes attached to an analytics entry
// ═══════════════════════════════════════════════════════════════════════════

model AnalyticsNote {
  id          String    @id @default(cuid())
  analyticsId String
  analytics   Analytics @relation(fields: [analyticsId], references: [id], onDelete: Cascade)
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  title       String    @default("Untitled")
  content     String?   @db.Text
  sortOrder   Int       @default(0)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([analyticsId])
  @@index([userId])
}

model Mt5Token {
  id               String         @id @default(cuid())
  token            String         @unique
  tradingAccountId String         @unique
  tradingAccount   TradingAccount @relation(fields: [tradingAccountId], references: [id], onDelete: Cascade)
  mt5Account       String
  broker           String?
  isActive         Boolean        @default(true)
  lastSyncAt       DateTime?
  lastConnectedAt  DateTime?
  commands         Mt5Command[]
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  @@index([token])
  @@index([mt5Account])
}

model Mt5Command {
  id             String    @id @default(cuid())
  mt5TokenId     String
  mt5Token       Mt5Token  @relation(fields: [mt5TokenId], references: [id], onDelete: Cascade)
  command        String
  acknowledged   Boolean   @default(false)
  acknowledgedAt DateTime?
  createdAt      DateTime  @default(now())

  @@index([mt5TokenId])
  @@index([acknowledged])
}

model CtraderToken {
  id                  String         @id @default(cuid())
  tradingAccountId    String         @unique
  tradingAccount      TradingAccount @relation(fields: [tradingAccountId], references: [id], onDelete: Cascade)
  ctidTraderAccountId String
  accessToken         String         @db.Text
  refreshToken        String         @db.Text
  expiresAt           DateTime?
  environment         String         @default("demo")
  brokerName          String?
  accountNumber       String?
  isActive            Boolean        @default(true)
  lastSyncAt          DateTime?
  lastConnectedAt     DateTime?
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt

  @@index([ctidTraderAccountId])
}

/** Per-user token pasted once into the TradeTrackSync MT5 Expert Advisor. Rotatable/revocable. */
model EaToken {
  id         String    @id @default(cuid())
  userId     String    @unique
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  token      String    @unique
  lastUsedAt DateTime?
  revokedAt  DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@index([token])
}

/** MT5 logins seen by the EA that the user has not yet approved. Drives "connect this account?" cards. */
model PendingMt5Account {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  login       String
  server      String
  company     String?
  currency    String?
  firstSeenAt DateTime @default(now())
  lastSeenAt  DateTime @default(now())

  @@unique([userId, login, server])
  @@index([userId])
}

model Feedback {
  id             String    @id @default(cuid())
  type           String
  email          String
  message        String    @db.Text
  telegramLink   String?
  phoneNumber    String?
  userId         String?
  user           User?     @relation(fields: [userId], references: [id], onDelete: SetNull)
  sentToTelegram Boolean   @default(false)
  repliedAt      DateTime?
  status         String    @default("new")
  createdAt      DateTime  @default(now())

  @@index([userId])
  @@index([createdAt])
  @@index([status])
}

model AiResponseFeedback {
  id                  String   @id @default(cuid())
  userId              String
  user                User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  surface             String // performance | symbols | sessions | days | insights
  filterHash          String
  responseGeneratedAt DateTime
  rating              String // 'up' | 'down'
  reasons             String[]
  comment             String?  @db.Text
  model               String?
  locale              String
  period              String
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  @@unique([userId, surface, filterHash])
  @@index([surface, rating])
  @@index([createdAt])
}

model TerminalImportFailure {
  id               String          @id @default(cuid())
  userId           String
  tradingAccountId String?
  terminal         String
  stage            String
  fileName         String
  fileUrl          String
  filePathname     String
  fileBytes        Int
  mimeType         String?
